# ============================================================
# MediPlan — POC chiffrement (modèle de configuration)
# Copier ce fichier en .env et remplir les valeurs réelles.
# Le vrai .env ne doit JAMAIS être versionné (voir .gitignore).
# ============================================================

# Clé de chiffrement AES-256-GCM — 32 octets en hexadécimal (64 caractères hex).
# Générer une clé : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# EBIOS R1 : cette clé vit hors base. Un dump SQL volé reste illisible sans elle.
CLE_CHIFFREMENT=

# URL de connexion PostgreSQL (base MediPlan chargée via bdd/init.sh).
# Format : postgresql://utilisateur:motdepasse@hote:port/nom_base
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mediplan